pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo '✅ Code récupéré depuis GitHub'
            }
        }

        stage('Tests Frontend') {
            steps {
                echo 'Aucun test frontend existant - skip'
            }
        }

        stage('Build Backend') {
            steps {
                dir('Stage-PFE-AICTO/backend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                    '''
                }
            }
        }

       stage('Tests Frontend') {
            steps {
                dir('Stage-PFE-AICTO/frontend') {
                    sh '''
                        npm ci
                        npm run test
                    '''
                }
            }
       }

       stage('Tests Backend') {
            steps {
                dir('Stage-PFE-AICTO/backend') {
                    sh '''
                        python3 -m venv venv_linux
                        . venv_linux/bin/activate
                        pip install -r requirements.txt
                        pytest tests/ --maxfail=1 -v
                    '''
                }
            }
       }

       stage('Deploy') {
            steps {
                echo '🚀 Déploiement terminé avec succès !'
            }
       }
    }

    post {
        success {
            echo '✅ Build réussi !'
        }
        failure {
            echo '❌ Build échoué - Vérifiez les logs'
        }
    }
}