pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo '✅ Code récupéré depuis GitHub'
            }
        }


        stage('Build Backend') {
            steps {
                dir('Stage-PFE-AICTO/backend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Tests Frontend') {
            steps {
                echo 'Aucun test frontend existant - skip'
            }
        }

        stage('Tests Backend') {
            steps {
                dir('Stage-PFE-AICTO/backend') {
                    sh '''
                        python3 -m venv venv_linux
                        . venv_linux/bin/activate
                        pip install -r requirements.txt
                        pytest tests/ --maxfail=1 -v
                    '''
                }
            }
        }
        stage('Build Docker Images') {
            steps {
                dir('Stage-PFE-AICTO') {
                    sh '''
                        docker-compose build
                    '''
                }
            }
        }
        stage('Deploy') {
            steps {
                dir('Stage-PFE-AICTO') {
                    sh '''
                        docker-compose up -d
                    '''
                    echo '🚀 Déploiement Docker terminé !'
                }
            }
        }
       

      
    }

    post {
        success {
            echo '✅ Build réussi !'
        }
        failure {
            echo '❌ Build échoué - Vérifiez les logs'
        }
    }
}