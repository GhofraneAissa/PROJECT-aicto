pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo '✅ Code récupéré depuis GitHub'
            }
        }

        stage('Build Backend') {
            steps {
                dir('Stage-PFE-AICTO/backend') {
                    sh '''
                        python3 -m venv venv
                        . venv/bin/activate
                        pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Tests Frontend') {
            steps {
                echo 'Aucun test frontend existant - skip'
            }
        }

        stage('Tests Backend') {
            steps {
                dir('Stage-PFE-AICTO/backend') {
                    sh '''
                        python3 -m venv venv_linux
                        . venv_linux/bin/activate
                        pip install -r requirements.txt
                        pytest tests/ --maxfail=1 -v
                    '''
                }
            }
        }

        stage('Build Docker Images') {
            steps {
                dir('Stage-PFE-AICTO') {
                    sh 'docker-compose build'
                }
            }
        }

        stage('Run Docker Containers') {
            steps {
                dir('Stage-PFE-AICTO') {
                    sh 'docker-compose up -d'
                }
            }
        }

        stage('Verify Containers') {
            steps {
                dir('Stage-PFE-AICTO') {
                    sh '''
                        echo '⏳ Attente du démarrage des containers...'
                        sleep 15
                        echo '--- docker-compose ps ---'
                        docker-compose ps
                        echo '--- Vérification backend (port 8000) ---'
                        curl -s -o /dev/null -w "HTTP %{http_code}\\n" http://localhost:8000/docs || { echo '❌ Backend injoignable'; exit 1; }
                        echo '--- Vérification frontend (port 3001) ---'
                        curl -s -o /dev/null -w "HTTP %{http_code}\\n" http://localhost:3001 || { echo '❌ Frontend injoignable'; exit 1; }
                        echo '✅ Containers opérationnels'
                    '''
                }
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline terminé - Containers Docker lancés'
        }
        failure {
            echo '❌ Build échoué'
            sh 'docker-compose logs --tail=20 2>/dev/null || true'
        }
    }
}
